{
  "name": "mcdev-mcp",
  "version": "2.2.1",
  "description": "MCP server for Minecraft mod development - provides decompiled code access, symbol search, and runtime interaction via DebugBridge",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcdev-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "resources",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js serve",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "mcpb": "bash scripts/build-mcpb.sh"
  },
  "keywords": [
    "minecraft",
    "mcp",
    "fabric",
    "modding",
    "decompiler",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/use-ai-for-mc/mcdev-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/use-ai-for-mc/mcdev-mcp/issues"
  },
  "homepage": "https://github.com/use-ai-for-mc/mcdev-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.16.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "glob": "^13.0.6",
    "java-parser": "^3.0.1",
    "sql.js": "^1.14.1",
    "unzipper": "^0.12.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/unzipper": "^0.10.10",
    "@types/ws": "^8.5.0",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
